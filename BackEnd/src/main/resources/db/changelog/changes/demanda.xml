<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="012-create-demanda" author="raissafernandesdesouza">
        <createTable tableName="demanda">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_demanda" nullable="false"/>
            </column>
            <column name="instituicao_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_demanda_instituicao" references="instituicao(id)"/>
            </column>
            <column name="data_criacao" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="data_limite" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="prioridade" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="finalidade" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="quantidade_pessoas_beneficiadas" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="justificativa" type="VARCHAR(500)"/>
            <column name="alerta_incompatibilidade" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="ABERTA">
                <constraints nullable="false"/>
            </column>
            <column name="observacao" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
