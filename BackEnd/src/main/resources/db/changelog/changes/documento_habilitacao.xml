<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-create-documento-habilitacao" author="raissafernandesdesouza">
        <createTable tableName="documento_habilitacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_documento_habilitacao" nullable="false"/>
            </column>
            <column name="instituicao_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_documento_habilitacao_instituicao" references="instituicao(id)"/>
            </column>
            <column name="tipo_documento" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="numero" type="VARCHAR(60)"/>
            <column name="arquivo" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="data_validade" type="DATE"/>
            <column name="status" type="VARCHAR(30)" defaultValue="PENDENTE">
                <constraints nullable="false"/>
            </column>
            <column name="data_envio" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
