<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="016-create-historico-status" author="raissafernandesdesouza">
        <createTable tableName="historico_status">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_historico_status" nullable="false"/>
            </column>
            <column name="entidade" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="entidade_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status_anterior" type="VARCHAR(30)"/>
            <column name="status_novo" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="data_alteracao" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints foreignKeyName="fk_historico_status_usuario" references="usuario(id)"/>
            </column>
            <column name="observacao" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
