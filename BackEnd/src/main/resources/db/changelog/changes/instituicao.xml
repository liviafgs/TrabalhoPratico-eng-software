<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-create-instituicao" author="raissafernandesdesouza">
        <createTable tableName="instituicao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_instituicao" nullable="false"/>
            </column>
            <column name="organizacao_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_instituicao_organizacao" foreignKeyName="fk_instituicao_organizacao" references="organizacao(id)"/>
            </column>
            <column name="quantidade_pessoas_atendidas" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="publico_atendido" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="capacidade_atendimento" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="frequencia_atendimento" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="habilitada" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="status_habilitacao" type="VARCHAR(30)" defaultValue="PENDENTE">
                <constraints nullable="false"/>
            </column>
            <column name="data_habilitacao" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
