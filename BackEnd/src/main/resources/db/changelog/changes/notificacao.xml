<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="017-create-notificacao" author="raissafernandesdesouza">
        <createTable tableName="notificacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_notificacao" nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_notificacao_usuario" references="usuario(id)"/>
            </column>
            <column name="titulo" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="mensagem" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="lida" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="data_criacao" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
