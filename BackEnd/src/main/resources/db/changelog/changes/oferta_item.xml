<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="011-create-oferta-item" author="raissafernandesdesouza">
        <createTable tableName="oferta_item">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_oferta_item" nullable="false"/>
            </column>
            <column name="oferta_doacao_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_oferta_item_oferta" references="oferta_doacao(id)"/>
            </column>
            <column name="item_alimentar_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_oferta_item_item" references="item_alimentar(id)"/>
            </column>
            <column name="quantidade" type="NUMERIC(10,3)">
                <constraints nullable="false"/>
            </column>
            <column name="quantidade_disponivel" type="NUMERIC(10,3)">
                <constraints nullable="false"/>
            </column>
            <column name="unidade_medida" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="validade" type="DATE"/>
            <column name="observacao" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
