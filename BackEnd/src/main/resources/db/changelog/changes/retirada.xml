<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="015-create-retirada" author="raissafernandesdesouza">
        <createTable tableName="retirada">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_retirada" nullable="false"/>
            </column>
            <column name="solicitacao_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_retirada_solicitacao" foreignKeyName="fk_retirada_solicitacao" references="solicitacao_doacao(id)"/>
            </column>
            <column name="data_agendada" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="hora_agendada" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="data_realizada" type="TIMESTAMP"/>
            <column name="responsavel_retirada" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="AGENDADA">
                <constraints nullable="false"/>
            </column>
            <column name="observacao" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
