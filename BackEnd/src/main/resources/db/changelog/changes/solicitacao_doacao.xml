<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="014-create-solicitacao-doacao" author="raissafernandesdesouza">
        <createTable tableName="solicitacao_doacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_solicitacao_doacao" nullable="false"/>
            </column>
            <column name="oferta_item_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_solicitacao_doacao_oferta_item" references="oferta_item(id)"/>
            </column>
            <column name="instituicao_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_solicitacao_doacao_instituicao" references="instituicao(id)"/>
            </column>
            <column name="data_solicitacao" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="quantidade_solicitada" type="NUMERIC(10,3)">
                <constraints nullable="false"/>
            </column>
            <column name="quantidade_aprovada" type="NUMERIC(10,3)"/>
            <column name="status" type="VARCHAR(30)" defaultValue="PENDENTE">
                <constraints nullable="false"/>
            </column>
            <column name="observacao" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
