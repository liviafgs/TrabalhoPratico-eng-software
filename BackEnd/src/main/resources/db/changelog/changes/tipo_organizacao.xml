<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-tipo-organizacao" author="raissafernandesdesouza">
        <createTable tableName="tipo_organizacao">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tipo_organizacao" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(60)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tipo_organizacao_nome"/>
            </column>
            <column name="descricao" type="VARCHAR(255)"/>
            <column name="ativo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
